# =============================================
# Angular Portfolio — .gitignore
# =============================================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build output
dist/
tmp/
out-tsc/
bazel-out/

# Angular cache
.angular/
.angular/cache/

# IDE & Editor
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Environment files (never commit secrets)
.env
.env.*
src/environments/environment.prod.ts

# Test coverage
coverage/
.nyc_output/

# Misc
*.log
*.zip
*.tar.gz
*.tgz